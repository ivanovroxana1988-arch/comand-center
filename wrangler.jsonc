{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comand-center",
  "main": "sites-source/dist/server/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "build": {
    "command": "npm ci && npx vite build && CI=true npx wrangler d1 migrations apply comand-center-db --remote --config ../wrangler.jsonc",
    "cwd": "sites-source",
    "watch_dir": "sites-source"
  },
  "assets": {
    "directory": "sites-source/dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "COMMAND_CENTER_SETUP_MODE": "false",
    "GOOGLE_CLIENT_ID": "89716203368-fhpjeobf3sa1t3vbr647ed5gg22g5v0f.apps.googleusercontent.com"
  },
  "observability": {
    "enabled": true
  },
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comand-center-db",
      "database_id": "267f8fd4-c357-4e74-87f0-2954ce6d36f5",
      "migrations_dir": "sites-source/drizzle"
    }
  ]
}
